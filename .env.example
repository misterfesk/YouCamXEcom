# live | mock — mock serves recorded responses and needs no key
YOUCAM_MODE=mock
YOUCAM_API_KEY=

# --- Scan backend (see src/lib/youcam, src/lib/server) ---
# Mock scenario served when YOUCAM_MODE=mock: success | face_too_small | too_dark | unavailable | slow
YOUCAM_MOCK_SCENARIO=success
# Pin the mock face (oily | dry | mature); unset picks one per upload
YOUCAM_MOCK_FACE=
# Override the YouCam API host (default https://yce-api-01.makeupar.com)
YOUCAM_API_BASE_URL=
# Signs scan ids and salts IP hashes. Required when YOUCAM_MODE=live (use 32+ random chars); mock/dev has a fixed fallback
SCAN_TOKEN_SECRET=
# Live scans allowed per visitor and in total per UTC day
SCAN_CAP_PER_IP=1
SCAN_CAP_GLOBAL=1
# Until RESERVE_RELEASE_AT, refuse if the initial measured budget minus charged/reserved
# units and one more full scan (26 units) would drop below this floor.
# 19 full scans across Nov 2-20 at 26 units each; > half the last recorded 851 units.
# Recompute against the actual deployment balance; keep previews in mock mode.
CREDIT_RESERVE_FLOOR=494
# From this ISO timestamp the floor is 0; UTC caps, the durable budget and provider balance still limit scans.
RESERVE_RELEASE_AT=2026-11-02T16:45:00Z
# Shared counters, permanent budget/spent ledger and 24h derived-profile cache.
# Required on Vercel live. Preserve keys; dedicated credit pool, previews mock.
# Ambiguous task charges stay held; top-ups require maintenance with no requests in flight.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Live mode on a single long-running instance (Docker/self-host) may opt into in-memory counters: memory
SCAN_STORE=
# Per-IP caps read x-forwarded-for / x-real-ip only on Vercel, with TRUST_PROXY=1, or in mock mode.
# Otherwise (live, self-hosted, no trusted proxy) all visitors share one bucket. Set to 1 only behind a proxy you control
TRUST_PROXY=

# Canonical public origin for metadata/sitemap. Set before building for deployment.
SITE_URL=http://localhost:3000
