# live | mock — mock serves recorded responses and needs no key
YOUCAM_MODE=mock
YOUCAM_API_KEY=
# Issued with the API key and shown only once. The v2 API doesn't use it; kept here for safekeeping.
YOUCAM_SECRET_KEY=

# --- Scan backend (see src/lib/youcam, src/lib/server) ---
# Mock scenario served when YOUCAM_MODE=mock: success | face_too_small | too_dark | unavailable | slow
YOUCAM_MOCK_SCENARIO=success
# Pin the mock face (oily | dry | mature); unset picks one per upload
YOUCAM_MOCK_FACE=
# Override the YouCam API host (default https://yce-api-01.makeupar.com)
YOUCAM_API_BASE_URL=
# Signs scan ids and salts IP hashes. Required when YOUCAM_MODE=live (use 32+ random chars); mock/dev has a fixed fallback
SCAN_TOKEN_SECRET=
# Live scans allowed per visitor and in total per UTC day
SCAN_CAP_PER_IP=3
SCAN_CAP_GLOBAL=20
# Refuse new scans when the YouCam balance minus one scan (26 units) would drop below this
CREDIT_RESERVE_FLOOR=425
# Shared counters and photo-hash cache; without these the app uses per-process memory (fine locally and in Docker)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
