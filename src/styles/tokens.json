{
  "$description": "[BRAND] design tokens — Swiss Cover, locked 2026-10-20. Source of truth for values; rules live in DESIGN.md. Format: W3C Design Tokens (DTCG).",
  "color": {
    "$type": "color",
    "bg": { "$value": "#FFFFFF", "$description": "Page background" },
    "surface": { "$value": "#F3F4F8", "$description": "Section bands, wells, inactive tiles" },
    "surface-raised": { "$value": "#FFFFFF", "$description": "Cards, popovers, modals (use with shadow.card / shadow.raised)" },
    "border": { "$value": "#DCDEE5", "$description": "Decorative dividers and card outlines only (1.34:1)" },
    "border-control": { "$value": "#8D9099", "$description": "Outlines of inputs, unselected chips, checkboxes (3.19:1)" },
    "border-strong": { "$value": "#101114", "$description": "1.5px outline on secondary + scan buttons" },
    "text": { "$value": "#101114" },
    "text-muted": { "$value": "#535866" },
    "neutral": { "$value": "#8D9099", "$description": "Non-text UI only" },
    "brand": { "$value": "#1C3FD6", "$description": "Cobalt: primary actions, hero field, links, focus ring" },
    "brand-hover": { "$value": "#1733B5" },
    "brand-soft": { "$value": "#3654DD", "$description": "Inner panels on a cobalt field" },
    "scan": { "$value": "#C6F135", "$description": "Lime. RESERVED for scan actions only (ScanButton component)" },
    "scan-hover": { "$value": "#B5DE2A" },
    "on-scan": { "$value": "#101114", "$description": "Text + 1.5px border on lime" },
    "lilac": { "$value": "#B7A6FF", "$description": "Editorial accent; Great match badge" },
    "lilac-tint": { "$value": "#EEEBFF", "$description": "Good match badge, soft tiles" },
    "tangerine": { "$value": "#FF6B1A", "$description": "Editorial accent, fill only, never text" },
    "success": { "$value": "#1E7A3C" },
    "success-tint": { "$value": "#E7F5EC" },
    "success-on-tint": { "$value": "#166534" },
    "warning": { "$value": "#A35A00" },
    "warning-tint": { "$value": "#FFF1E0" },
    "warning-on-tint": { "$value": "#8A4B00" },
    "danger": { "$value": "#C2261B" },
    "danger-tint": { "$value": "#FDECEA" },
    "danger-on-tint": { "$value": "#A61F16" },
    "scrim": { "$value": "rgba(16, 17, 20, 0.48)" }
  },
  "badge": {
    "great-match": { "bg": { "$type": "color", "$value": "{color.lilac}" }, "fg": { "$type": "color", "$value": "{color.text}" } },
    "good-match": { "bg": { "$type": "color", "$value": "{color.lilac-tint}" }, "fg": { "$type": "color", "$value": "{color.text}" } },
    "everyday-pick": { "bg": { "$type": "color", "$value": "{color.surface}" }, "fg": { "$type": "color", "$value": "{color.text-muted}" }, "border": { "$type": "color", "$value": "{color.border}" } },
    "use-with-care": { "bg": { "$type": "color", "$value": "{color.warning-tint}" }, "fg": { "$type": "color", "$value": "{color.warning-on-tint}" } },
    "not-for-your-skin": { "bg": { "$type": "color", "$value": "{color.danger-tint}" }, "fg": { "$type": "color", "$value": "{color.danger-on-tint}" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": { "$value": ["Archivo", "Helvetica Neue", "Arial", "sans-serif"] },
      "accent": { "$value": ["Bodoni Moda", "Didot", "Bodoni 72", "Georgia", "serif"], "$description": "Italic 400 only, 1–2 words per headline" }
    },
    "googleFontsUrl": { "$value": "https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Bodoni+Moda:ital,wght@1,400&display=swap" }
  },
  "typography": {
    "display": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "clamp(48px, 6vw, 84px)", "lineHeight": 0.98, "fontWeight": 800, "fontStretch": "80%", "letterSpacing": "-0.02em" } },
    "h1": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "56px", "lineHeight": "56px", "fontWeight": 800, "fontStretch": "80%", "letterSpacing": "-0.02em" }, "$description": "Mobile 40/42" },
    "h2": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "44px", "lineHeight": "48px", "fontWeight": 800, "fontStretch": "80%", "letterSpacing": "-0.02em" }, "$description": "Mobile 32/36" },
    "h3": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "22px", "lineHeight": "28px", "fontWeight": 700 } },
    "body-lg": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "18px", "lineHeight": "28px", "fontWeight": 400 } },
    "body": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "16px", "lineHeight": "25px", "fontWeight": 400 } },
    "small": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "13px", "lineHeight": "18px", "fontWeight": 400 } },
    "label": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 700, "letterSpacing": "0.06em", "textTransform": "uppercase" } },
    "button": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "15px", "lineHeight": "1", "fontWeight": 700 } },
    "badge": { "$value": { "fontFamily": "{font.family.base}", "fontSize": "12px", "lineHeight": "16px", "fontWeight": 700 } },
    "accent": { "$value": { "fontFamily": "{font.family.accent}", "fontStyle": "italic", "fontWeight": 400, "fontStretch": "100%", "letterSpacing": "0" }, "$description": "Inherits size from its headline" }
  },
  "radius": {
    "$type": "dimension",
    "pill": { "$value": "999px" },
    "card": { "$value": "16px" },
    "panel": { "$value": "20px" },
    "hero": { "$value": "28px" },
    "swatch": { "$value": "10px" }
  },
  "shadow": {
    "$type": "shadow",
    "card": { "$value": "0 8px 24px rgba(16, 17, 20, 0.06)" },
    "raised": { "$value": "0 8px 24px rgba(16, 17, 20, 0.08)" },
    "modal": { "$value": "0 24px 64px rgba(16, 17, 20, 0.18)" }
  },
  "border-width": {
    "$type": "dimension",
    "default": { "$value": "1px" },
    "strong": { "$value": "1.5px" },
    "focus": { "$value": "2px" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "5": { "$value": "20px" }, "6": { "$value": "24px" }, "7": { "$value": "28px" }, "8": { "$value": "32px" },
    "12": { "$value": "48px" }, "14": { "$value": "56px" }, "16": { "$value": "64px" }, "20": { "$value": "80px" }
  },
  "size": {
    "$type": "dimension",
    "control-height": { "$value": "48px" },
    "control-height-lg": { "$value": "56px" },
    "chip-height": { "$value": "44px" },
    "icon-button": { "$value": "44px" },
    "mobile-scan-fab": { "$value": "56px" },
    "container-max": { "$value": "1280px" },
    "container-pad": { "$value": "32px" },
    "container-pad-mobile": { "$value": "16px" }
  },
  "breakpoint": {
    "$type": "dimension",
    "mobile": { "$value": "390px" },
    "tablet": { "$value": "768px" },
    "hero-two-col": { "$value": "1024px" },
    "desktop": { "$value": "1280px" }
  },
  "motion": {
    "duration-ui": { "$type": "duration", "$value": "200ms" },
    "duration-enter": { "$type": "duration", "$value": "400ms" },
    "easing": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  }
}
